// ==========================================================
// Exams / Results
// Entered and updated by faculty only; students have
// read-only access at the API layer, and never see a Result
// until its status is PUBLISHED.
// ==========================================================

model Exam {
  id               String         @id @default(uuid())
  semesterCourseId String
  semesterCourse   SemesterCourse @relation(fields: [semesterCourseId], references: [id])
  examType         ExamType
  title            String?
  examDate         DateTime
  totalMarks       Float
  weightage        Float?
  status           ExamStatus     @default(DRAFT)

  results Result[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([semesterCourseId])
  @@index([examDate])
  @@index([status])
  @@map("exams")
}

model Result {
  id                 String           @id @default(uuid())
  examId             String
  exam               Exam             @relation(fields: [examId], references: [id])
  studentId          String
  student            StudentProfile   @relation(fields: [studentId], references: [id])
  courseEnrollmentId String
  courseEnrollment   CourseEnrollment @relation(fields: [courseEnrollmentId], references: [id])
  marksObtained      Float
  grade              Grade?
  gradePoint         Float?
  status             ResultStatus     @default(DRAFT)
  publishedAt        DateTime?
  enteredById        String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@index([status])
  @@map("results")
}
