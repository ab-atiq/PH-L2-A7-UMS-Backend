// ==========================================================
// Finance: Invoices / Payments
//
// FeeInvoice.type distinguishes the one-time program ADMISSION
// fee (linked via programId) from a recurring SEMESTER fee
// (linked via semesterEnrollmentId). Exactly one of the two
// link fields is expected to be set, matching `type` — enforced
// in the service layer/validation, not the database.
// ==========================================================

model FeeInvoice {
  id            String         @id @default(uuid())
  invoiceNumber String         @unique
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])

  type InvoiceType

  // Set when type = ADMISSION
  programId String?
  program   Program? @relation(fields: [programId], references: [id])

  // Set when type = SEMESTER
  semesterEnrollmentId String?
  semesterEnrollment   SemesterEnrollment? @relation(fields: [semesterEnrollmentId], references: [id])

  description String
  amount      Decimal       @db.Decimal(10, 2)
  dueDate     DateTime
  status      InvoiceStatus @default(PENDING)

  payments Payment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@index([type])
  @@map("fee_invoices")
}

model Payment {
  id               String         @id @default(uuid())
  transactionId    String         @unique
  invoiceId        String
  invoice          FeeInvoice     @relation(fields: [invoiceId], references: [id])
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id])
  amount           Decimal        @db.Decimal(10, 2)
  gateway          PaymentGateway
  status           PaymentStatus  @default(INITIATED)
  gatewayReference String?
  gatewayResponse  Json?
  paidAt           DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([invoiceId])
  @@index([studentId])
  @@index([status])
  @@index([transactionId])
  @@map("payments")
}
