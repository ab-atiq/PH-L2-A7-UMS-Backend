// ==========================================================
// Academic Hierarchy: Department -> Program -> Course
//
// NOTE: Course prerequisites are no longer modeled at the
// individual-course level. Progression is gated per semester
// instead — see ProgramSemester / SemesterEnrollment in
// program-semesters.prisma and enrollment-attendance.prisma:
// a student cannot start ProgramSemester N until their
// SemesterEnrollment for N-1 is COMPLETED (enforced in the
// service layer; N=1 has no prior semester to satisfy).
// ==========================================================

model Department {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  description String?
  status      EntityStatus @default(ACTIVE)

  programs        Program[]
  courses         Course[]
  studentProfiles StudentProfile[]
  facultyProfiles FacultyProfile[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([code])
  @@index([status])
  @@map("departments")
}

model Program {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  degreeType     DegreeType
  // Denormalized for quick display ("Semester 3 of 8"); kept in sync by the
  // service layer with the count of ProgramSemester rows for this program
  // (BSC = 8, MSC = 4, PHD = 6).
  totalSemesters Int
  durationYears  Int
  totalCredits   Int

  // One-time fee charged when a student is admitted into this program.
  admissionFee Decimal @db.Decimal(10, 2)
  // Recurring fee charged for every semester of this program (flat 50,000 by default).
  semesterFee  Decimal @default(50000) @db.Decimal(10, 2)

  status EntityStatus @default(ACTIVE)

  students         StudentProfile[]
  programSemesters ProgramSemester[]
  feeInvoices      FeeInvoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([code])
  @@index([departmentId])
  @@index([status])
  @@index([degreeType])
  @@map("programs")
}

model Course {
  id           String       @id @default(uuid())
  courseCode   String       @unique
  title        String
  description  String?
  credits      Int
  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id])
  status       CourseStatus @default(DRAFT)

  // Placements of this course into a program's curriculum (one per
  // program-semester it's taught in, each with its own assigned teacher).
  semesterCourses SemesterCourse[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([courseCode])
  @@index([departmentId])
  @@index([status])
  @@map("courses")
}
