// ==========================================================
// Role Profiles
// ==========================================================

model StudentProfile {
  id                       String           @id @default(uuid())
  userId                   String           @unique
  user                     User             @relation(fields: [userId], references: [id])
  studentId                String           @unique
  programId                String?
  program                  Program?         @relation(fields: [programId], references: [id])
  departmentId             String?
  department               Department?      @relation(fields: [departmentId], references: [id])
  // Which semester (of their own program's curriculum) they are currently on.
  currentProgramSemesterId String?
  currentProgramSemester   ProgramSemester? @relation(fields: [currentProgramSemesterId], references: [id])

  batchYear     Int?
  gender        Gender?
  dateOfBirth   DateTime?
  address       String?
  guardianName  String?
  guardianPhone String?
  admissionDate DateTime?

  semesterEnrollments SemesterEnrollment[]
  courseEnrollments   CourseEnrollment[]
  attendances         Attendance[]
  results             Result[]
  feeInvoices         FeeInvoice[]
  payments            Payment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([studentId])
  @@index([programId])
  @@index([departmentId])
  @@map("student_profiles")
}

model FacultyProfile {
  id             String      @id @default(uuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id])
  employeeId     String      @unique
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  designation    String?
  specialization String?
  joinDate       DateTime?

  // Courses (within a specific program semester) this faculty member teaches.
  semesterCourses SemesterCourse[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([employeeId])
  @@index([departmentId])
  @@map("faculty_profiles")
}
